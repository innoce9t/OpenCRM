{
  "name": "opencrm",
  "version": "0.1.0",
  "description": "Open-source CRM with a monday.com-style board interface",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node server/index.js",
    "dev:client": "vite client",
    "build": "vite build client",
    "start": "NODE_ENV=production node server/index.js",
    "electron": "vite build client && electron .",
    "electron:dev": "node scripts/electron-dev.js",
    "dist": "vite build client && electron-builder --win"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.11"
  },
  "main": "electron/main.cjs",
  "author": "Ahsan Nawazish",
  "build": {
    "appId": "app.opencrm.desktop",
    "productName": "OpenCRM",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**",
      "server/**",
      "client/dist/**",
      "!server/data/**",
      "!server/serviceAccount.json",
      "!**/*serviceAccount*.json",
      "!**/.env"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCRM"
    }
  }
}
